{
    "name": "lta-madt-gui",
    "version": "5.1.19",
    "private": true,
    "scripts": {
        "build": "ng build  --aot --output-hashing=all",
        "start": "ng serve",
        "start:local:network": "ng serve --host=0.0.0.0 --disable-host-check",
        "test": "CHROME_BIN=$(which chromium-browser || which chromium || which google-chrome || echo chrome) npx ng test --browsers=ChromeHeadless",
        "test:coverage": "CHROME_BIN=$(which chromium-browser || which chromium || which google-chrome || echo chrome) npx ng test --browsers=ChromeHeadless --code-coverage --watch=false",
        "ng:clear:cache": "ng cache clean",
        "test:clean": "ng cache clean",
        "lint:check": "npm run lint:check:eslint && npm run lint:check:prettier",
        "lint:check:eslint": "npx eslint .",
        "lint:check:prettier": "npx prettier --check './**/*.{ts,tsx,js,jsx,md,json,css,scss,less}'",
        "lint:fix": "npm run lint:fix:eslint && npm run lint:fix:prettier",
        "lint:fix:eslint": "npx eslint --fix .",
        "lint:fix:prettier": "npx prettier --write './**/*.{ts,tsx,js,jsx,md,json,css,scss,less}'",
        "prepare": "husky",
        "serve:ssr:lta-btds-gui": "node dist/lta-btds-gui/server/server.mjs",
        "watch": "ng build --watch --configuration development",
        "lint": "ng lint"
    },
    "dependencies": {
        "@angular/animations": "^21.2.14",
        "@angular/cdk": "^21.2.12",
        "@angular/common": "^21.2.14",
        "@angular/compiler": "^21.2.14",
        "@angular/core": "^21.2.14",
        "@angular/forms": "^21.2.14",
        "@angular/material": "^21.2.12",
        "@angular/platform-browser": "^21.2.14",
        "@angular/platform-browser-dynamic": "^21.2.14",
        "@angular/platform-server": "^21.2.14",
        "@angular/router": "^21.2.14",
        "@angular/ssr": "^21.2.12",
        "@ngrx/store": "^21.1.0",
        "@ngx-translate/core": "^17.0.0",
        "@ngx-translate/http-loader": "^17.0.0",
        "@types/mqtt": "^2.5.0",
        "crypto-js": "^4.2.0",
        "express": "^4.22.2",
        "mqtt": "^5.15.1",
        "ngx-scrollbar": "^15.1.3",
        "rxjs": "~7.8.2",
        "tslib": "^2.8.1",
        "zone.js": "~0.15.1"
    },
    "devDependencies": {
        "@angular-eslint/builder": "^21.4.0",
        "@angular-eslint/eslint-plugin": "^21.4.0",
        "@angular-eslint/eslint-plugin-template": "^21.4.0",
        "@angular-eslint/schematics": "^21.4.0",
        "@angular-eslint/template-parser": "^21.4.0",
        "@angular/build": "^21.2.12",
        "@angular/cli": "^21.2.12",
        "@angular/compiler-cli": "^21.2.14",
        "@types/express": "^4.17.25",
        "@types/jasmine": "~5.1.15",
        "@types/node": "^24.12.4",
        "@typescript-eslint/eslint-plugin": "^8.59.4",
        "@typescript-eslint/parser": "^8.59.4",
        "@typescript-eslint/type-utils": "^8.59.4",
        "@typescript-eslint/utils": "^8.59.4",
        "baseline-browser-mapping": "^2.10.31",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-simple-import-sort": "12.1.0",
        "husky": "9.0.11",
        "jasmine-core": "~5.1.2",
        "karma": "~6.4.4",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "lint-staged": "15.2.2",
        "prettier": "3.2.5",
        "prettier-eslint": "^16.4.2",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.59.4"
    }
}
